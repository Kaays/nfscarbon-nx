# Nothing derived from the game is ever committed: its files, the code generated from default.xex, and the
# binaries built from that code.

# --- Game files ---------------------------------------------------------------
assets/
*.xex
*.xexp
*.iso
*.bin
*.big
*.bun
*.lzc

# --- Generated from the game --------------------------------------------------
app/generated/
app/unregistered_targets.txt

# --- Build output -------------------------------------------------------------
out/
build/
*.nro
*.nacp
*.elf
*.o
*.obj
*.log
*.err

# --- Tools --------------------------------------------------------------------
__pycache__/
*.pyc
.vs/
.vscode/

# --- Personal icon (may be made from copyrighted art: never published) ---------
tools/switch/icon/nfscarbon_icon_local.jpg
pgo/

# --- Third-party sources fetched by tools/fetch_thirdparty.py -----------------
# Only the files this port changed are tracked (they stay tracked); the rest is downloaded. New port changes in
# here need `git add -f`.
sdk/thirdparty/*
!sdk/thirdparty/CMakeLists.txt
